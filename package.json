{
  "name": "sealpage",
  "productName": "Sealpage",
  "version": "1.0.0",
  "description": "Encrypted structured text editor for Windows 11",
  "private": true,
  "author": "Josiah Legg",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "gen": "node scripts/gen-style-index.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/gen-style-index.mjs && tsc --noEmit -p tsconfig.json",
    "start": "node scripts/build.mjs && electron .",
    "test:unit": "node scripts/gen-style-index.mjs && vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test -c tests/playwright.config.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "node scripts/build.mjs --production && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/young-serif": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.12.0",
    "lucide": "^1.55.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-search": "^1.1.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.sealpage.app",
    "productName": "Sealpage",
    "copyright": "Sealpage",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "compression": "normal",
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sealpage",
      "artifactName": "Sealpage-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "slpg",
        "name": "Sealpage Document",
        "description": "Sealpage encrypted document",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    }
  }
}
